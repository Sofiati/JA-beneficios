{
  "name": "ja-beneficios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JA Benefícios — landing page em HTML + CSS + TypeScript (Vite, vanilla)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/gerar-rota-privacidade.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc --noEmit",
    "deploy:zip": "node scripts/deploy-zip.mjs",
    "typecheck": "tsc --noEmit",
    "audit:cores": "node scripts/audit-cores.mjs",
    "test:build": "node --test scripts/rota-privacidade.test.mjs",
    "hero:mobile": "node scripts/gerar-hero-mobile.mjs",
    "hero:fallbacks": "node scripts/gerar-fallbacks-hero.mjs",
    "og:image": "node scripts/gerar-og-image.mjs",
    "check": "npm run typecheck && npm run build && npm run test:build && npm run audit:cores"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
